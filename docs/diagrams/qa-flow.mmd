flowchart TD
    A["用户提交问题"] --> B["JWT 身份验证"]
    B --> C["获取用户权限"]
    C --> D["获取对话上下文"]
    D --> E["Query Rewrite 问题改写"]
    E --> F["构建检索条件 含权限过滤"]
    F --> G1["BM25 检索"]
    F --> G2["向量检索"]
    G1 --> H["RRF 结果融合"]
    G2 --> H
    H --> I["Reranker 重排序"]
    I --> J{"相关性是否足够"}
    J -->|否| K["拒答 / 提示补充信息"]
    J -->|是| L["构建 Prompt"]
    L --> M["调用 LLM"]
    M --> N["生成答案与引用"]
    N --> O["保存问答记录"]
    O --> P["返回用户"]
